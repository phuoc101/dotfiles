#! /usr/bin/bash

# ---
# Options handling
mode="nord"
while getopts "ldnp" OPTION; do
    case "$OPTION" in
        d)
            mode="dark"
            ;;
        l)
            mode="light"
            ;;
        n)
            mode="nord"
            ;;
        \?)
            echo "Invalid option -OPTARG" >&2
            exit 1
            ;;
    esac
done

# ---
# Wallpapers setup
if [ "$mode" == "nord" ]; then
    notify-send "Set nord mode walls"
    MY_WALLS_DIR=$HOME/dotfiles/wallpapers_nord
elif [ $mode == "dark" ]; then
    notify-send "Set dark mode walls"
    MY_WALLS_DIR=$HOME/dotfiles/wallpapers_dark
else
    notify-send "Set light mode walls"
    MY_WALLS_DIR=$HOME/dotfiles/wallpapers_light
fi

XRANDR_OUT=$(xrandr)
if [[ $XRANDR_OUT == *"HDMI-1-0 connected"* ]]; then
    autorandr --load hdmi
    notify-send "Initialized display" "hdmi"
    xrandr --output HDMI-1-0 --primary
elif [[ $XRANDR_OUT == *"DisplayPort-1 connected"* ]]; then
    autorandr --load dual_2k
    notify-send "Initialized display" "dual_2k"
    xrandr --output DisplayPort-1 --primary
else
    autorandr --load mobile
    xrandr --output eDP --primary
    notify-send "Initialized display" "mobile"
    if [ "$poly_init" == true ]; then
        ~/.config/polybar/scripts/launch.sh
    fi
fi

$HOME/.local/bin/init_wallpapers -f "$MY_WALLS_DIR"
